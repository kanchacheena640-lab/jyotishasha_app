# ---------------------------------------------------------------
# Machine/profile-level noise (project is stored inside the user
# profile directory on this machine — see audit 2026-08-08)
# ---------------------------------------------------------------

# Build tool caches (not project-local — these are global tool homes)
/.gradle/
/.android/
/.m2/
/.nuget/

# Editor / AI-tool config & extension data (nothing here is currently tracked)
/.vscode/
/.gemini/
/.copilot/
